    "@react-navigation/native": "^6.1.9",
    "@rneui/base": "^4.0.0-rc.7",
    "expo": "~49.0.15",
    "expo-status-bar": "~1.6.0",
    "firebase": "^10.6.0",
    "moment": "^2.31.0",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.72.6",
    "react-native-calendars": "^1.1302.0",
    "react-native-safe-area-context": "^4.7.4",
    "react-native-screens": "^3.27.0",
    "react-native-web": "^0.19.13",
    "expo-asset": "~8.10.1"
  },
  "devDependencies": {
